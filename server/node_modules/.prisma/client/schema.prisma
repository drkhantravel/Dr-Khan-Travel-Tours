generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  Pending
  Confirmed
  Cancelled
  Completed
}

enum MessageStatus {
  Unread
  Read
  Replied
}

model Booking {
  bookingId          String        @id @map("booking_id")
  tourId             String        @map("tour_id")
  tourTitle          String        @map("tour_title")
  tourPricePerPerson Int           @map("tour_price_per_person")
  totalAmount        Int           @map("total_amount")
  fullName           String        @map("full_name")
  email              String        @map("email")
  phone              String        @map("phone")
  travelersCount     Int           @map("travelers_count")
  travelDate         String        @map("travel_date")
  specialRequests    String?       @map("special_requests") @db.Text
  status             BookingStatus @default(Pending)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  @@map("bookings")
}

model ContactMessage {
  id         String        @id
  name       String
  email      String
  phone      String?
  subject    String?
  message    String        @db.Text
  status     MessageStatus @default(Unread)
  receivedAt DateTime      @default(now()) @map("received_at")

  @@map("contact_messages")
}

model TourPackage {
  id           String   @id
  title        String
  category     String
  destination  String
  duration     String
  price        Int
  rating       Float    @default(4.9)
  reviewsCount Int      @default(1) @map("reviews_count")
  image        String   @db.Text
  badge        String?
  description  String   @db.Text
  highlights   String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("tour_packages")
}

model SiteSetting {
  id        String   @id @default("default")
  appName   String   @map("app_name")
  logoUrl   String   @map("logo_url") @db.Text
  logoText  String   @map("logo_text")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model AboutSlide {
  id        String   @id
  imageUrl  String   @map("image_url") @db.Text
  caption   String?  @map("caption")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("about_slides")
}

model ClientGalleryItem {
  id        String   @id
  title     String
  category  String
  image     String   @db.Text
  subtitle  String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("client_gallery_items")
}
