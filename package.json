{
  "name": "dr-khan-travel-tours",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --prefix client",
    "dev:all": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "build": "npm run prisma:generate && npm run build --prefix client",
    "start": "npm run start --prefix server",
    "client:dev": "npm run dev --prefix client",
    "client:build": "npm run build --prefix client",
    "server:dev": "npm run dev --prefix server",
    "server:start": "npm run start --prefix server",
    "prisma:generate": "prisma generate --schema=server/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=server/prisma/schema.prisma",
    "prisma:pull": "prisma db pull --schema=server/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=server/prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema=server/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=server/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mysql2": "^3.24.4",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0"
  }
}
